VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_CHANNEL=

# Backend configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
REDIS_URL=
# Base64 of at least 32 random bytes (never reuse OTP_HMAC_KEY)
JWT_SIGNING_KEY=
JWT_ISSUER=https://api.beez.example
JWT_AUDIENCE=beez-pwa
# At least 32 random characters; store separately from JWT_SIGNING_KEY
OTP_HMAC_KEY=
REFRESH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_BUSINESS_SHORT_CODE=
# Public HTTPS URL ending in /api/v1/payments/callback/<MPESA_CALLBACK_TOKEN>
MPESA_CALLBACK_URL=
# Generate a unique random token with at least 32 characters; never reuse another secret.
MPESA_CALLBACK_TOKEN=
PAYMENT_CALLBACK_POLL_INTERVAL_MS=2000
# Comma-separated UUIDs of trusted Beez operators; leave empty until Admin is connected.
OPERATIONS_USER_IDS=
SMS_PRIMARY_API_URL=https://sms.blessedtexts.com/api/sms/v1/sendsms
SMS_FALLBACK_API_URL=https://api.vaspro.co.ke/v3/BulkSMS/api/create
SMS_API_KEY=
SMS_SENDER_ID=
SMS_CALLBACK_URL=
# Configure through the deployment secret manager; voice processing is disabled without this key.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_PRODUCT_MODEL=gpt-4o-mini
ORDER_ALERT_POLL_INTERVAL_MS=5000
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
