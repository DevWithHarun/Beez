# Supabase project configuration
SUPABASE_PROJECT_ID=your-supabase-project-ref
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Vite client configuration
VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SMS provider configuration
SMS_PRIMARY_API_URL=https://sms.blessedtexts.com/api/sms/v1/sendsms
SMS_FALLBACK_API_URL=https://api.vaspro.co.ke/v3/BulkSMS/api/create
SMS_API_KEY=replace-with-your-sms-provider-api-key
SMS_SENDER_ID=your-sender-id
SMS_CALLBACK_URL=

# M-Pesa Daraja B2C (configure as Supabase Edge Function secrets, not VITE_ vars)
# Set these in Supabase Dashboard > Edge Functions > Secrets, or with `supabase secrets set`.
# Do not put real credentials in this file.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=replace-with-daraja-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
DARAJA_SHORTCODE=replace-with-b2c-shortcode
DARAJA_TILL_NUMBER=replace-with-mpesa-till-number
DARAJA_STORE_NUMBER=replace-with-mpesa-store-number
DARAJA_INITIATOR_NAME=replace-with-initiator-name
DARAJA_SECURITY_CREDENTIAL=replace-with-encrypted-initiator-credential
DARAJA_CALLBACK_TOKEN=replace-with-long-random-callback-token
DARAJA_COMMAND_ID=BusinessPayment

# Supabase Edge Function runtime secrets used by the payout functions.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY above are also required there.
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
